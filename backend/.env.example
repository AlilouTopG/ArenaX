# ArenaX Backend
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database
# - DEVELOPMENT: leave empty to use an in-memory MongoDB (no install needed, demo data auto-seeded, resets on restart)
# - PRODUCTION: REQUIRED - MongoDB Atlas free cluster, e.g. MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/arenax
#   The server refuses to boot in production without MONGO_URI (no in-memory fallback).
MONGO_URI=
AUTO_SEED=true

# Redis (optional - recommended for production rate limiting & clusters)
REDIS_URL=redis://127.0.0.1:6379

# JWT Secrets (MANDATORY in production - never commit real values)
JWT_ACCESS_SECRET=change_me_long_random_access_secret
JWT_REFRESH_SECRET=change_me_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=ArenaX

# CORS - comma separated allowed origins (5173 = vite dev, 4173 = vite preview)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Rate Limiting (RLF)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=5

# AI News Engine
# AI key is ONLY used on the backend. Never expose to frontend.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
NEWS_FETCH_INTERVAL_MIN=30
# comma separated RSS feeds (Arabic sports sources)
# run `npm run fetch-news` to fetch & publish news immediately.
NEWS_SOURCES=https://www.aljazeera.net/xml/rss/sports.xml,https://www.kooora.com/?rss=1,https://www.ennaharonline.com/feed/

# Coach Notifications
TELEGRAM_BOT_TOKEN=
WHATSAPP_WEBHOOK_URL=

# Logging
LOG_LEVEL=info